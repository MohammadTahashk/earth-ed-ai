# Server-only Gemini configuration for the Vite API endpoint.
# Never prefix this key with VITE_ and never expose it to browser code.
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (PostgreSQL)
# Example: postgresql://username:password@localhost:5432/earthed_db
DATABASE_URL=postgresql://username:password@localhost:5432/earthed_db

# Server Configuration
PORT=3000
NODE_ENV=development

# Session/JWT Secret (generate a secure random string)
SESSION_SECRET=your_session_secret_here

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
